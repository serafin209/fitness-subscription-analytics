      <aliases enabled='yes' />
      <column caption='Acquisition Channel' datatype='string' name='[Acquisition_Channel]' role='dimension' type='nominal' />
      <column caption='Cohort Month ' datatype='datetime' name='[Calculation_3757898893246465]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{fixed [Customer_ID] :&#10;    min(&#10;        IF [Transaction_Type] = &quot;Subscription&quot;&#10;        THEN DATETRUNC(&quot;month&quot;, [Transaction_Date])&#10;        END&#10;            )&#10;}' />
      </column>
      <column aggregation='Sum' caption='Months Since Subscription Start' datatype='integer' name='[Calculation_3757898894888962]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&#10;    &quot;month&quot;,&#10;    [Calculation_3757898893246465],&#10;    DATETRUNC(&quot;month&quot;, [Transaction_Date])&#10;)' />
      </column>
      <column caption='Cohort Size ' datatype='integer' name='[Calculation_3757898897383427]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_3757898893246465] :&#10;    COUNTD(&#10;        IF [Transaction_Type] = &quot;SUBSCRIPTION&quot;&#10;            AND [Calculation_3757898894888962] = 0&#10;        THEN [Customer_ID]&#10;        END&#10;    )   &#10;}' />
      </column>
      <column caption='Retention Rate' datatype='real' default-format='p0.0%' name='[Calculation_3757898898968580]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_ID])/ MIN([Calculation_3757898897383427])' />
      </column>
      <column caption='StartOfMonth' datatype='datetime' name='[Calculation_3757898901741573]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&quot;month&quot;, [Transaction_Date])' />
      </column>
      <column aggregation='Sum' caption='Cohort Year' datatype='integer' name='[Calculation_3757898904985606]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Calculation_3757898893246465])' />
      </column>
      <column caption='Total Cac' datatype='real' name='[Calculation_3757898906669063]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_3757898904985606]:&#10;        SUM(&#10;            IF [Transaction_Type] = &quot;Subscription&quot;&#10;                AND [Calculation_3757898894888962] = 0&#10;            THEN [CAC]&#10;            END&#10;    )&#10;}' />
      </column>
